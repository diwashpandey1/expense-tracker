rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validAmount(value) {
      return value is string && value.matches('^[1-9][0-9]{0,14}$');
    }

    function validMinorTotal(value) {
      return value is string && value.matches('^(0|[1-9][0-9]{0,14})$');
    }

    function validDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function supportedCurrency(value) {
      return value in ['USD', 'EUR', 'GBP', 'INR', 'NPR', 'AUD', 'CAD', 'JPY', 'CNY', 'SGD', 'CHF', 'NZD'];
    }

    function validAccountCurrency(uid, accountId, currencyCode) {
      let path = /databases/$(database)/documents/users/$(uid)/accounts/$(accountId);
      return currencyCode is string && exists(path) && get(path).data.currencyCode == currencyCode;
    }

    function validCategory(uid, categoryId, kind, snapshotName) {
      let path = /databases/$(database)/documents/users/$(uid)/categories/$(categoryId);
      return categoryId is string
        && exists(path)
        && get(path).data.kind == kind
        && get(path).data.isArchived == false
        && get(path).data.name == snapshotName;
    }

    function validCategorySplit(uid, line) {
      return line is map
        && line.keys().hasOnly(['categoryId', 'categoryName', 'amountMinor'])
        && line.keys().hasAll(['categoryId', 'categoryName', 'amountMinor'])
        && validAmount(line.amountMinor)
        && validCategory(uid, line.categoryId, 'expense', line.categoryName);
    }

    function validCategorySplits(uid, splits) {
      return splits is list
        && splits.size() >= 2
        && splits.size() <= 3
        && validCategorySplit(uid, splits[0])
        && validCategorySplit(uid, splits[1])
        && (splits.size() < 3 || validCategorySplit(uid, splits[2]));
    }

    function validGoal(uid, goalId, snapshotName) {
      let path = /databases/$(database)/documents/users/$(uid)/goals/$(goalId);
      return goalId is string
        && exists(path)
        && get(path).data.status == 'active'
        && get(path).data.name == snapshotName;
    }

    function validAccount(uid, accountId) {
      let path = /databases/$(database)/documents/users/$(uid)/accounts/$(accountId);
      return accountId is string && exists(path) && get(path).data.status == 'active';
    }

    function validPreferenceAccount(uid, accountId) {
      return accountId == '' || validAccount(uid, accountId);
    }

    function validPreferenceCategory(uid, categoryId) {
      let path = /databases/$(database)/documents/users/$(uid)/categories/$(categoryId);
      return categoryId == '' || (categoryId is string && exists(path) && get(path).data.isArchived == false);
    }

    function validAccountBalanceChange(uid, accountId) {
      let operationPath = /databases/$(database)/documents/users/$(uid)/financialOperations/$(request.resource.data.lastOperationId);
      return request.resource.data.lastOperationId is string
        && existsAfter(operationPath)
        && getAfter(operationPath).data.uid == uid
        && getAfter(operationPath).data.deltas is map
        && getAfter(operationPath).data.deltas[accountId] == request.resource.data.balanceMinor - resource.data.balanceMinor;
    }

    function validEventPosting(uid, operationId, accountId) {
      let accountPath = /databases/$(database)/documents/users/$(uid)/accounts/$(accountId);
      let operationPath = /databases/$(database)/documents/users/$(uid)/financialOperations/$(operationId);
      return exists(accountPath)
        && existsAfter(accountPath)
        && existsAfter(operationPath)
        && getAfter(accountPath).data.lastOperationId == operationId
        && getAfter(operationPath).data.deltas[accountId] == getAfter(accountPath).data.balanceMinor - get(accountPath).data.balanceMinor;
    }

    match /users/{uid} {
      allow read: if signedIn(uid);
      allow create: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'currencyCode', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'currencyCode', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.currencyCode is string
        && request.resource.data.currencyCode.matches('^[A-Z]{3}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'currencyCode', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.currencyCode is string
        && request.resource.data.currencyCode.matches('^[A-Z]{3}$')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn(uid);

      match /settings/{settingId} {
        allow read: if signedIn(uid);
        allow create, update: if signedIn(uid)
          && settingId == 'preferences'
          && request.resource.data.keys().hasOnly(['appearance', 'dashboard', 'transactions', 'budget', 'notifications', 'privacy', 'currency', 'updatedAt'])
          && request.resource.data.keys().hasAll(['appearance', 'dashboard', 'transactions', 'budget', 'notifications', 'privacy', 'currency', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.appearance is map
          && request.resource.data.appearance.theme in ['light', 'dark', 'system']
          && request.resource.data.appearance.accent in ['lime', 'sage', 'blue', 'rose', 'violet']
          && request.resource.data.appearance.density in ['compact', 'comfortable']
          && request.resource.data.appearance.fontSize in ['small', 'normal', 'large']
          && request.resource.data.appearance.sidebarCollapsed is bool
          && request.resource.data.appearance.animations is bool
          && request.resource.data.dashboard is map
          && request.resource.data.dashboard.widgets is map
          && request.resource.data.dashboard.widgets.keys().hasOnly(['balance', 'income', 'expenses', 'savings', 'budgets', 'goals', 'recentTransactions', 'spendingBreakdown', 'forecast', 'insights'])
          && request.resource.data.dashboard.widgetOrder is list
          && request.resource.data.dashboard.widgetOrder.size() == 4
          && request.resource.data.dashboard.widgetOrder.toSet() == ['balance', 'income', 'expenses', 'savings'].toSet()
          && request.resource.data.dashboard.widgetSizes is map
          && request.resource.data.dashboard.widgetSizes.keys().hasOnly(['balance', 'income', 'expenses', 'savings'])
          && request.resource.data.dashboard.widgetSizes.keys().hasAll(['balance', 'income', 'expenses', 'savings'])
          && request.resource.data.dashboard.widgetSizes.values().toSet().hasOnly(['regular', 'wide'])
          && request.resource.data.dashboard.defaultPeriod in ['weekly', 'monthly', 'yearly', 'lifetime']
          && request.resource.data.dashboard.analyticsChartType in ['pie', 'bar', 'line']
          && request.resource.data.dashboard.recentTransactionCount in [5, 10, 20]
          && request.resource.data.dashboard.hideAmounts is bool
          && request.resource.data.currency is map
          && request.resource.data.currency.keys().hasOnly(['displayCurrency'])
          && request.resource.data.currency.displayCurrency is string
          && supportedCurrency(request.resource.data.currency.displayCurrency)
          && request.resource.data.transactions is map
          && request.resource.data.transactions.defaultType in ['income', 'expense', 'transfer']
          && request.resource.data.transactions.defaultAccountId is string
          && validPreferenceAccount(uid, request.resource.data.transactions.defaultAccountId)
          && request.resource.data.transactions.defaultCategoryId is string
          && validPreferenceCategory(uid, request.resource.data.transactions.defaultCategoryId)
          && request.resource.data.transactions.dateFormat in ['iso', 'us', 'eu', 'locale']
          && request.resource.data.transactions.weekStartsOn in ['sunday', 'monday']
          && request.resource.data.transactions.listView in ['comfortable', 'compact']
          && request.resource.data.transactions.sort in ['newest', 'oldest', 'amount-high', 'amount-low']
          && request.resource.data.transactions.confirmBeforeSave is bool
          && request.resource.data.budget is map
          && request.resource.data.budget.warningThreshold is int
          && request.resource.data.budget.warningThreshold >= 1
          && request.resource.data.budget.warningThreshold <= 99
          && request.resource.data.budget.defaultPeriod in ['monthly', 'yearly']
          && request.resource.data.budget.progressDisplay in ['bar', 'ring', 'both']
          && request.resource.data.notifications is map
          && request.resource.data.notifications.budgetThreshold is bool
          && request.resource.data.notifications.overspending is bool
          && request.resource.data.notifications.recurringReminders is bool
          && request.resource.data.notifications.savingsGoalReminders is bool
          && request.resource.data.notifications.monthlySummary is bool
          && request.resource.data.privacy is map
          && request.resource.data.privacy.hideBalances is bool;
        allow delete: if signedIn(uid);
      }

      match /categories/{categoryId} {
        allow read: if signedIn(uid);
        allow create: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['kind', 'name', 'normalizedName', 'isArchived', 'isDefault', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['kind', 'name', 'normalizedName', 'isArchived', 'isDefault', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['income', 'expense', 'saving']
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.normalizedName is string
          && request.resource.data.normalizedName == request.resource.data.name.lower().trim()
          && request.resource.data.isArchived == false
          && request.resource.data.isDefault is bool
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if signedIn(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'normalizedName', 'isArchived', 'updatedAt'])
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.isDefault == resource.data.isDefault
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.normalizedName == request.resource.data.name.lower().trim()
          && request.resource.data.isArchived is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn(uid);
      }

      match /transactions/{transactionId} {
        allow read: if signedIn(uid);
        allow create: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['kind', 'amountMinor', 'occurredOn', 'categoryId', 'categoryName', 'goalId', 'goalName', 'note', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['kind', 'amountMinor', 'occurredOn', 'categoryId', 'categoryName', 'goalId', 'goalName', 'note', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['income', 'expense', 'savings_contribution', 'savings_withdrawal']
          && validAmount(request.resource.data.amountMinor)
          && validDate(request.resource.data.occurredOn)
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && ((request.resource.data.kind in ['income', 'expense']
                && request.resource.data.goalId == null
                && request.resource.data.goalName == null
                && validCategory(uid, request.resource.data.categoryId, request.resource.data.kind, request.resource.data.categoryName))
              || (request.resource.data.kind in ['savings_contribution', 'savings_withdrawal']
                && validGoal(uid, request.resource.data.goalId, request.resource.data.goalName)
                && ((request.resource.data.categoryId == null && request.resource.data.categoryName == null)
                  || validCategory(uid, request.resource.data.categoryId, 'saving', request.resource.data.categoryName))));
        allow update: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['kind', 'amountMinor', 'occurredOn', 'categoryId', 'categoryName', 'goalId', 'goalName', 'note', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['kind', 'amountMinor', 'occurredOn', 'categoryId', 'categoryName', 'goalId', 'goalName', 'note', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['income', 'expense', 'savings_contribution', 'savings_withdrawal']
          && validAmount(request.resource.data.amountMinor)
          && validDate(request.resource.data.occurredOn)
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && ((request.resource.data.kind in ['income', 'expense']
                && request.resource.data.goalId == null
                && request.resource.data.goalName == null
                && validCategory(uid, request.resource.data.categoryId, request.resource.data.kind, request.resource.data.categoryName))
              || (request.resource.data.kind in ['savings_contribution', 'savings_withdrawal']
                && validGoal(uid, request.resource.data.goalId, request.resource.data.goalName)
                && ((request.resource.data.categoryId == null && request.resource.data.categoryName == null)
                  || validCategory(uid, request.resource.data.categoryId, 'saving', request.resource.data.categoryName))));
        allow delete: if signedIn(uid);
      }

      match /budgets/{budgetId} {
        allow read: if signedIn(uid);
        allow create, update: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['month', 'year', 'period', 'categoryId', 'categoryName', 'amountMinor', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['categoryId', 'categoryName', 'amountMinor', 'createdAt', 'updatedAt'])
          && (('period' in request.resource.data.keys() && request.resource.data.period == 'yearly')
            ? request.resource.data.year is string && request.resource.data.year.matches('^[0-9]{4}$')
            : request.resource.data.month is string && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
              && (!('period' in request.resource.data.keys()) || request.resource.data.period == 'monthly'))
          && validAmount(request.resource.data.amountMinor)
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.categoryId == null
            ? request.resource.data.categoryName == null
            : validCategory(uid, request.resource.data.categoryId, 'expense', request.resource.data.categoryName))
          && (request.method == 'create'
            ? request.resource.data.createdAt == request.time
            : request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if signedIn(uid);
      }

      match /goals/{goalId} {
        allow read: if signedIn(uid);
        allow create: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['name', 'targetMinor', 'targetDate', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['name', 'targetMinor', 'targetDate', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && validAmount(request.resource.data.targetMinor)
          && (request.resource.data.targetDate == null || validDate(request.resource.data.targetDate))
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['name', 'targetMinor', 'targetDate', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['name', 'targetMinor', 'targetDate', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && validAmount(request.resource.data.targetMinor)
          && (request.resource.data.targetDate == null || validDate(request.resource.data.targetDate))
          && request.resource.data.status in ['active', 'completed', 'archived']
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn(uid);
      }

      match /accounts/{accountId} {
        allow read: if signedIn(uid);
        allow create: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['name', 'accountType', 'classification', 'currencyCode', 'openingBalanceMinor', 'balanceMinor', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.accountType in ['cash', 'bank', 'ewallet', 'other']
          && request.resource.data.classification in ['spending', 'savings']
          && request.resource.data.currencyCode.matches('^[A-Z]{3}$')
          && (request.resource.data.openingBalanceMinor == '0' || validAmount(request.resource.data.openingBalanceMinor))
          && request.resource.data.balanceMinor is int && request.resource.data.balanceMinor >= 0
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if signedIn(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'accountType', 'classification', 'status', 'balanceMinor', 'lastOperationId', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.accountType in ['cash', 'bank', 'ewallet', 'other']
          && request.resource.data.classification in ['spending', 'savings']
          && request.resource.data.status in ['active', 'archived']
          && request.resource.data.balanceMinor is int && request.resource.data.balanceMinor >= 0
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.balanceMinor == resource.data.balanceMinor || validAccountBalanceChange(uid, accountId));
        allow delete: if signedIn(uid);
      }

      match /financeState/{stateId} {
        allow read: if signedIn(uid);
        allow create, update: if signedIn(uid)
          && stateId == 'summary'
          && request.resource.data.keys().hasOnly(['savingsBalanceMinor', 'goalAllocatedMinor', 'updatedAt'])
          && request.resource.data.keys().hasAll(['savingsBalanceMinor', 'goalAllocatedMinor', 'updatedAt'])
          && validMinorTotal(request.resource.data.savingsBalanceMinor)
          && validMinorTotal(request.resource.data.goalAllocatedMinor)
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn(uid);
      }

      match /financialOperations/{operationId} {
        allow read: if signedIn(uid);
        allow create: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['uid', 'kind', 'deltas', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.kind is string
          && request.resource.data.deltas is map
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn(uid);
      }

      match /ledgerEntries/{entryId} {
        allow read: if signedIn(uid);
        allow create: if signedIn(uid)
          && request.resource.data.kind in ['income', 'expense', 'transfer', 'adjustment']
          && validAmount(request.resource.data.amountMinor)
          && validDate(request.resource.data.occurredOn)
          && request.resource.data.postings is list
          && (!('currencyCode' in request.resource.data.keys()) || validAccountCurrency(uid, request.resource.data.accountId, request.resource.data.currencyCode))
          && (!('categorySplits' in request.resource.data.keys()) || request.resource.data.categorySplits == null || validCategorySplits(uid, request.resource.data.categorySplits))
          && request.resource.data.lastOperationId is string
          && existsAfter(/databases/$(database)/documents/users/$(uid)/financialOperations/$(request.resource.data.lastOperationId))
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if signedIn(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind', 'operationKind', 'amountMinor', 'accountId', 'destinationAccountId', 'savingsAccountId', 'allocationAdjustments', 'categoryId', 'categoryName', 'categorySplits', 'occurredOn', 'note', 'postings', 'lastOperationId', 'updatedAt', 'voided', 'voidedAt'])
          && (!('categorySplits' in request.resource.data.keys()) || request.resource.data.categorySplits == null || validCategorySplits(uid, request.resource.data.categorySplits))
          && request.resource.data.updatedAt == request.time
          && validEventPosting(uid, request.resource.data.lastOperationId, request.resource.data.accountId)
          && (request.resource.data.destinationAccountId == null || validEventPosting(uid, request.resource.data.lastOperationId, request.resource.data.destinationAccountId))
          && (request.resource.data.savingsAccountId == null || validEventPosting(uid, request.resource.data.lastOperationId, request.resource.data.savingsAccountId));
        allow delete: if signedIn(uid);
      }

      match /currencyRates/{baseCurrency} {
        allow read: if signedIn(uid);
        allow create: if signedIn(uid)
          && supportedCurrency(baseCurrency)
          && request.resource.data.keys().hasOnly(['baseCurrency', 'rates', 'rateDate', 'syncedAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['baseCurrency', 'rates', 'rateDate', 'syncedAt', 'updatedAt'])
          && request.resource.data.baseCurrency == baseCurrency
          && request.resource.data.rates is map
          && request.resource.data.rates.keys().hasOnly(['USD', 'EUR', 'GBP', 'INR', 'NPR', 'AUD', 'CAD', 'JPY', 'CNY', 'SGD', 'CHF', 'NZD'])
          && request.resource.data.rates.keys().hasAll(['USD', 'EUR', 'GBP', 'INR', 'NPR', 'AUD', 'CAD', 'JPY', 'CNY', 'SGD', 'CHF', 'NZD'])
          && request.resource.data.rateDate is string
          && request.resource.data.syncedAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if signedIn(uid)
          && supportedCurrency(baseCurrency)
          && request.resource.data.keys().hasOnly(['baseCurrency', 'rates', 'rateDate', 'syncedAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['baseCurrency', 'rates', 'rateDate', 'syncedAt', 'updatedAt'])
          && request.resource.data.baseCurrency == baseCurrency
          && request.resource.data.rates is map
          && request.resource.data.rates.keys().hasOnly(['USD', 'EUR', 'GBP', 'INR', 'NPR', 'AUD', 'CAD', 'JPY', 'CNY', 'SGD', 'CHF', 'NZD'])
          && request.resource.data.rates.keys().hasAll(['USD', 'EUR', 'GBP', 'INR', 'NPR', 'AUD', 'CAD', 'JPY', 'CNY', 'SGD', 'CHF', 'NZD'])
          && request.resource.data.rateDate is string
          && request.resource.data.syncedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.time >= resource.data.syncedAt + duration.value(7, 'd');
        allow delete: if signedIn(uid);
      }

      match /auditEvents/{auditId} {
        allow read: if signedIn(uid);
        allow create: if signedIn(uid) && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn(uid);
      }

      match /goalAllocations/{goalId} {
        allow read: if signedIn(uid);
        allow create, update: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['goalId', 'goalName', 'amountMinor', 'createdAt', 'updatedAt'])
          && request.resource.data.goalId == goalId
          && request.resource.data.goalName is string
          && validGoal(uid, goalId, request.resource.data.goalName)
          && (request.resource.data.amountMinor == '0' || validAmount(request.resource.data.amountMinor))
          && request.resource.data.updatedAt == request.time
          && (request.method == 'create' ? request.resource.data.createdAt == request.time : request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if signedIn(uid);
      }

      match /recurringSchedules/{scheduleId} {
        allow read: if signedIn(uid);
        allow create, update: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['name', 'kind', 'amountMinor', 'accountId', 'categoryId', 'categoryName', 'frequency', 'intervalDays', 'startOn', 'endOn', 'nextDueOn', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['income', 'expense']
          && validAmount(request.resource.data.amountMinor)
          && validAccount(uid, request.resource.data.accountId)
          && validCategory(uid, request.resource.data.categoryId, request.resource.data.kind, request.resource.data.categoryName)
          && request.resource.data.frequency in ['daily', 'weekly', 'monthly', 'yearly', 'custom']
          && request.resource.data.status in ['active', 'paused', 'cancelled']
          && validDate(request.resource.data.startOn)
          && validDate(request.resource.data.nextDueOn)
          && (request.resource.data.endOn == null || validDate(request.resource.data.endOn))
          && (request.resource.data.frequency == 'custom'
            ? request.resource.data.intervalDays is int && request.resource.data.intervalDays >= 1 && request.resource.data.intervalDays <= 365
            : request.resource.data.intervalDays == null)
          && request.resource.data.updatedAt == request.time
          && (request.method == 'create' ? request.resource.data.createdAt == request.time : request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if signedIn(uid);
      }

      match /recurringOccurrences/{occurrenceId} {
        allow read: if signedIn(uid);
        allow create, update: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['scheduleId', 'name', 'kind', 'amountMinor', 'accountId', 'categoryId', 'categoryName', 'dueOn', 'status', 'errorMessage', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['income', 'expense']
          && validAmount(request.resource.data.amountMinor)
          && validDate(request.resource.data.dueOn)
          && validAccount(uid, request.resource.data.accountId)
          && validCategory(uid, request.resource.data.categoryId, request.resource.data.kind, request.resource.data.categoryName)
          && request.resource.data.status in ['pending_confirmation', 'pending_funding', 'failed', 'posted']
          && request.resource.data.updatedAt == request.time
          && (request.method == 'create' ? request.resource.data.createdAt == request.time : request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if signedIn(uid);
      }

      match /transactions/{transactionId} {
        allow create: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['kind', 'operationKind', 'amountMinor', 'accountId', 'destinationAccountId', 'savingsAccountId', 'allocationAdjustments', 'lastOperationId', 'occurredOn', 'categoryId', 'categoryName', 'categorySplits', 'goalId', 'goalName', 'note', 'postings', 'currencyCode', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['income', 'expense', 'transfer']
          && validAmount(request.resource.data.amountMinor)
          && validDate(request.resource.data.occurredOn)
          && request.resource.data.note is string && request.resource.data.note.size() <= 500
          && validAccount(uid, request.resource.data.accountId)
          && (!('currencyCode' in request.resource.data.keys()) || validAccountCurrency(uid, request.resource.data.accountId, request.resource.data.currencyCode))
          && request.resource.data.lastOperationId == transactionId
          && existsAfter(/databases/$(database)/documents/users/$(uid)/ledgerEntries/$(transactionId))
          && existsAfter(/databases/$(database)/documents/users/$(uid)/financialOperations/$(transactionId))
          && validEventPosting(uid, transactionId, request.resource.data.accountId)
          && (request.resource.data.kind != 'transfer' || validEventPosting(uid, transactionId, request.resource.data.destinationAccountId))
          && (request.resource.data.savingsAccountId == null || validEventPosting(uid, transactionId, request.resource.data.savingsAccountId))
          && (request.resource.data.kind == 'transfer'
            ? validAccount(uid, request.resource.data.destinationAccountId)
            : validCategory(uid, request.resource.data.categoryId, request.resource.data.kind, request.resource.data.categoryName))
          && (!('categorySplits' in request.resource.data.keys()) || request.resource.data.categorySplits == null || (request.resource.data.kind == 'expense' && validCategorySplits(uid, request.resource.data.categorySplits) && request.resource.data.categorySplits[0].categoryId == request.resource.data.categoryId && request.resource.data.categorySplits[0].categoryName == request.resource.data.categoryName))
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if signedIn(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind', 'operationKind', 'amountMinor', 'accountId', 'destinationAccountId', 'savingsAccountId', 'allocationAdjustments', 'occurredOn', 'categoryId', 'categoryName', 'categorySplits', 'goalId', 'goalName', 'note', 'postings', 'lastOperationId', 'updatedAt', 'voided', 'voidedAt'])
          && request.resource.data.updatedAt == request.time
          && (!('categorySplits' in request.resource.data.keys()) || request.resource.data.categorySplits == null || (request.resource.data.kind == 'expense' && validCategorySplits(uid, request.resource.data.categorySplits) && request.resource.data.categorySplits[0].categoryId == request.resource.data.categoryId && request.resource.data.categorySplits[0].categoryName == request.resource.data.categoryName))
          && validEventPosting(uid, request.resource.data.lastOperationId, request.resource.data.accountId)
          && (request.resource.data.destinationAccountId == null || validEventPosting(uid, request.resource.data.lastOperationId, request.resource.data.destinationAccountId))
          && (request.resource.data.savingsAccountId == null || validEventPosting(uid, request.resource.data.lastOperationId, request.resource.data.savingsAccountId));
        allow delete: if false;
      }
    }
  }
}
