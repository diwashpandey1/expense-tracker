# Fresh Firebase web app config only. Replace from the NEW Firebase project.
# These Vite values are public client config; never put service-account/Admin credentials here.
VITE_FIREBASE_API_KEY=replace_with_new_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_new_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_new_project_id
VITE_FIREBASE_APP_ID=replace_with_new_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=
VITE_CONTACT_EMAIL=
VITE_CURRENCY_API_KEY=replace_with_currencyapi_key
